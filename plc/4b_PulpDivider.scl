// Трёхструйный пульподелитель: 3 задвижки (№1 — зумпф мельницы 1; №2, №3 — зумпф мельниц 2 и 3).
// Управление толчками: выход «открыть/закрыть» включён, только пока оператор держит кнопку на панели.
// Степень открытия оператор регулирует визуально. Импортировать перед 5_GCU_HMI.scl.
// Номер DB HMI_PD задайте вручную: 103.

TYPE "UDT_HmiPD"
TITLE = 'Задвижка пульподелителя для панели (4 байта)'
VERSION : 0.1
   STRUCT
      F : Struct   // +0.0
         Opened : Bool;   // концевик ОТКРЫТА
         Closed : Bool;   // концевик ЗАКРЫТА
         Opening : Bool;   // идёт открытие (кнопка нажата)
         Closing : Bool;   // идёт закрытие (кнопка нажата)
         Middle : Bool;   // промежуточное положение (оба концевика = 0)
         FltLimits : Bool;   // оба концевика = 1
         FltTimeout : Bool;   // непрерывное движение дольше JogMax — выход снят до отпускания кнопки
         FltSignal : Bool;   // недостоверный сигнал концевика
         Res8 : Bool;
         Res9 : Bool;
         Res10 : Bool;
         Res11 : Bool;
         Res12 : Bool;
         Res13 : Bool;
         Res14 : Bool;
         Res15 : Bool;
      END_STRUCT;
      JogTime : Int;   // +2  время текущего непрерывного движения, 0.1 с
   END_STRUCT;

END_TYPE

DATA_BLOCK "HMI_PD"
TITLE = 'Обмен с панелью: пульподелитель'
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
//Панель, пока кнопка нажата, каждые 200 мс пишет Cmd и увеличивает Alive.
//Alive не меняется 0,7 с — ПЛК обнуляет Cmd (потеря связи / кнопка отпущена без записи).
   STRUCT
      Cmd : Int;   // 0  0 — стоп; 11, 12, 13 — открывать задвижку 1..3; 21, 22, 23 — закрывать
      Alive : Int;   // 2  счётчик подтверждения удержания (пишет панель)
      JogMax : Int;   // 4  максимум непрерывного движения, с (1..600)
      Res : Int;   // 6
      V : Array[1..3] of "UDT_HmiPD";   // 8  состояние задвижек — размер DB 20 байт
   END_STRUCT;


BEGIN
   JogMax := 30;

END_DATA_BLOCK

FUNCTION_BLOCK "FB_PD_Valve"
TITLE = 'Задвижка пульподелителя: толчковое управление'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      N : Int;   // номер задвижки 1..3 (коды Cmd 10+N / 20+N)
      DiOpen : Int;   // индекс DI концевика ОТКРЫТА
      DiClose : Int;   // индекс DI концевика ЗАКРЫТА
      DoOpen : Int;   // индекс DO «открыть»
      DoClose : Int;   // индекс DO «закрыть»
      Cmd : Int;   // команда панели после сторожа связи
      JogMax : Time;   // максимум непрерывного движения
   END_VAR

   VAR_IN_OUT 
      St : "UDT_HmiPD";
   END_VAR

   VAR 
      tJog {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      Lock : Bool;   // превышено JogMax — ждём отпускания кнопки
   END_VAR

   VAR_TEMP 
      Qual : Bool;
      Opened : Bool;
      Closed : Bool;
      WantOpen : Bool;
      WantClose : Bool;
      Run : Bool;
   END_VAR


BEGIN
	#Qual := TRUE;
	#Opened := "DI_Read"(ID := #DiOpen, Quality := #Qual);
	#Closed := "DI_Read"(ID := #DiClose, Quality := #Qual);
	
	// открывать — пока не сработал концевик ОТКРЫТА; закрывать — пока не сработал ЗАКРЫТА
	#WantOpen := (#Cmd = 10 + #N) AND NOT #Opened AND #Qual;
	#WantClose := (#Cmd = 20 + #N) AND NOT #Closed AND #Qual;
	IF #Opened AND #Closed THEN   // оба концевика — неисправность, не двигаем
	    #WantOpen := FALSE;
	    #WantClose := FALSE;
	END_IF;
	
	// кнопка отпущена — блокировка по времени снимается
	IF (#Cmd <> 10 + #N) AND (#Cmd <> 20 + #N) THEN
	    #Lock := FALSE;
	END_IF;
	#Run := (#WantOpen OR #WantClose) AND NOT #Lock;
	#tJog(IN := #Run, PT := #JogMax);
	IF #tJog.Q THEN
	    #Lock := TRUE;
	    #Run := FALSE;
	END_IF;
	
	IF (#DoOpen > 0) AND (#DoOpen <= "DO".Count) THEN
	    "DO".Item[#DoOpen].Value := #Run AND #WantOpen;
	END_IF;
	IF (#DoClose > 0) AND (#DoClose <= "DO".Count) THEN
	    "DO".Item[#DoClose].Value := #Run AND #WantClose;
	END_IF;
	
	#St.F.Opened := #Opened;
	#St.F.Closed := #Closed;
	#St.F.Opening := #Run AND #WantOpen;
	#St.F.Closing := #Run AND #WantClose;
	#St.F.Middle := NOT #Opened AND NOT #Closed;
	#St.F.FltLimits := #Opened AND #Closed;
	#St.F.FltTimeout := #Lock;
	#St.F.FltSignal := NOT #Qual;
	#St.JogTime := DINT_TO_INT(TIME_TO_DINT(#tJog.ET) / 100);

END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_PD"
TITLE = 'Пульподелитель: сторож связи с панелью и три задвижки'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      tAlive {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      AlivePrev : Int;
      V1 : "FB_PD_Valve";
      V2 : "FB_PD_Valve";
      V3 : "FB_PD_Valve";
   END_VAR

   VAR_TEMP 
      Cmd : Int;
      TMax : Time;
   END_VAR


BEGIN
	// панель подтверждает удержание кнопки сменой Alive; нет смены 0,7 с — стоп
	#tAlive(IN := "HMI_PD".Alive = #AlivePrev, PT := T#700MS);
	#AlivePrev := "HMI_PD".Alive;
	IF #tAlive.Q THEN
	    "HMI_PD".Cmd := 0;
	END_IF;
	#Cmd := "HMI_PD".Cmd;
	"HMI_PD".JogMax := LIMIT(MN := 1, IN := "HMI_PD".JogMax, MX := 600);
	#TMax := DINT_TO_TIME(INT_TO_DINT("HMI_PD".JogMax) * 1000);
	
	// DI 75..80 (%I4.0..4.5), DO 37..42 (%Q2.0..2.5)
	#V1(N := 1, DiOpen := 75, DiClose := 76, DoOpen := 37, DoClose := 38, Cmd := #Cmd, JogMax := #TMax, St := "HMI_PD".V[1]);
	#V2(N := 2, DiOpen := 77, DiClose := 78, DoOpen := 39, DoClose := 40, Cmd := #Cmd, JogMax := #TMax, St := "HMI_PD".V[2]);
	#V3(N := 3, DiOpen := 79, DiClose := 80, DoOpen := 41, DoClose := 42, Cmd := #Cmd, JogMax := #TMax, St := "HMI_PD".V[3]);

END_FUNCTION_BLOCK

DATA_BLOCK "iPD"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"FB_PD"

BEGIN

END_DATA_BLOCK

