// Стандартная обработка сигналов (TDIData/TDOData/TAIData/TAOData, *_HNDL)
// + DB сигналов ГЦУ. Компилировать ПЕРВЫМ.

TYPE "TDOData"
TITLE = 'Сигналы дискретного выхода. Данные'
VERSION : 0.1
   STRUCT
      Active : Bool := TRUE;   // Признак активности
      Value : Bool;   // Значение переменной
      Quality : Bool;   // Признак достоверности
      Mask : Bool;   // Признак маскирования сигнала
      MaskValue : Bool;   // Значение маскирования сигнала
      Inverse : Bool;   // Признак инверсии
      RawVal : Bool;   // Значение сигнала
      StatBit_REV : Bool := TRUE;   // Инверсия статусного бита (1-инверсия)
      Quality_inv : Bool;   // Признак достоверности инвертированный
      RES_3 : Bool;   // Резерв
      RES_4 : Bool;   // Резерв
      RES_5 : Bool;   // Резерв
      RES_6 : Bool;   // Резерв
      RES_7 : Bool;   // Резерв
      RES_8 : Bool;   // Резерв
      RES_9 : Bool;   // Резерв
      RES_10 : Real;   // Резерв
      RES_11 : Real;   // Резерв
      StatusBYTE : Int := -1;   // Адрес байта статуса
      StatusBIT : Int := -1;   // Номер бита качества в статус-байте
      AdrByte : Int := -1;   // Адрес (байт)
      AdrBit : Int := -1;   // Адрес (бит)
      RES_13 : Int;   // Резерв
   END_STRUCT;

END_TYPE

TYPE "TDIData"
TITLE = 'Сигналы дискретного входа. Данные'
VERSION : 0.1
   STRUCT
      Active : Bool := TRUE;   // Признак активности
      Value : Bool;   // Значение переменной
      Quality : Bool;   // Признак достоверности
      Mask : Bool;   // Признак маскирования сигнала
      MaskValue : Bool;   // Значение маскирования сигнала
      AlmUse : Bool;   // Признак алармирования
      IsAlarm : Bool;   // Авария (сигнал активен в течение TimeOut)
      Inverse : Bool;   // Признак инверсии
      RawVal : Bool;   // Значение сигнала
      ValuePrev : Bool;   // Значение фильтрованной переменной
      AlmMode : Bool;   // Режим аларма: 1-Тревога по 1, 0-Тревога по 0
      AlmDisable : Bool;   // Деактивация алармов
      StatBit_REV : Bool := TRUE;   // Инверсия статусного бита (1-инверсия)
      Quality_inv : Bool;   // Признак достоверности инвертированный
      RES_4 : Bool;   // Резерв
      RES_5 : Bool;   // Резерв
      RES_6 : Bool;   // Резерв
      Tf : Real := 0.1;   // Постоянная фильтра, с
      Acc : Real;   // Аккумулятор времени фильтрации
      StatusBYTE : Int := -1;   // Адрес байта статуса
      StatusBIT : Int := -1;   // Номер бита качества в статус-байте
      AdrByte : Int := -1;   // Адрес (байт)
      AdrBit : Int := -1;   // Адрес (бит)
      Timeout : DInt := DINT#3000;   // Время, в течение которого срабатывает аларм
      TimeAlarm : DInt := DINT#0;   // Текущее время аварии
   END_STRUCT;

END_TYPE

TYPE "TAOData"
TITLE = 'Сигналы аналогового выхода. Данные'
VERSION : 0.1
   STRUCT
      Active : Bool := TRUE;   // Признак активности
      RES_1 : Bool;   // Резерв
      RES_2 : Bool;   // Резерв
      RES_3 : Bool;   // Резерв
      RES_4 : Bool;   // Резерв
      RES_5 : Bool;   // Резерв
      RES_6 : Bool;   // Резерв
      RES_7 : Bool;   // Резерв
      RES_8 : Bool;   // Резерв
      RES_9 : Bool;   // Резерв
      RES_10 : Bool;   // Резерв
      RES_11 : Bool;   // Резерв
      RES_12 : Bool;   // Резерв
      Quality_inv : Bool;   // Признак достоверности инвертированный
      Quality : Bool;   // Признак достоверности
      Mask { S7_SetPoint := 'True'} : Bool;   // Признак маскирования сигнала
      Value : Real;   // Значение переменной
      MaskValue { S7_SetPoint := 'True'} : Real;   // Значение маскирования сигнала
      MinEU { S7_SetPoint := 'True'} : Real := 0.0;   // Мин. значение шкалы
      MaxEU { S7_SetPoint := 'True'} : Real := 100.0;   // Макс. значение шкалы
      Current : Real;   // Значение тока, mA
      RES_14 : Real;   // Резерв
      AOType { S7_SetPoint := 'True'} : Int := 0;   // Тип сигнала
      RES_15 : Int;   // Резерв
      AdrByte { S7_SetPoint := 'True'} : Int := -1;   // Адрес (байт)
      MinRaw { S7_SetPoint := 'True'} : Int := 0;   // Мин. значение сигнала
      MaxRaw { S7_SetPoint := 'True'} : Int := 27648;   // Макс. значение сигнала
      RawVal : Int;   // Первоначальное значение (не масштабированное)
      RES_16 : Int;   // Резерв
      RES_17 : Int;   // Резерв
   END_STRUCT;

END_TYPE

TYPE "TAIData"
TITLE = 'Сигналы аналогового входа. Данные'
VERSION : 0.1
   STRUCT
      Active : Bool := TRUE;   // Признак активности
      AlmDisable : Bool;   // Деактивация алармов
      RES_2 : Bool;   // Резервный бит
      RES_3 : Bool;   // Резервный бит
      RES_4 : Bool;   // Резервный бит
      Quality_inv : Bool;   // Признак достоверности инвертированный
      Quality : Bool;   // Признак достоверности
      Mask { S7_SetPoint := 'True'} : Bool;   // Признак маскирования сигнала
      AlmHiHi : Bool;   // Авария  (сигнал > ВАУ в течение Timeout)
      AlmHi : Bool;   // Тревога (сигнал > ВПУ в течение Timeout)
      AlmLo : Bool;   // Тревога (сигнал < НПУ в течение Timeout)
      AlmLoLo : Bool;   // Авария  (сигнал < НАУ в течение Timeout)
      HiHiUse { S7_SetPoint := 'True'} : Bool;   // Признак использования ВАУ
      HiUse { S7_SetPoint := 'True'} : Bool;   // Признак использования ВПУ
      LoUse { S7_SetPoint := 'True'} : Bool;   // Признак использования НПУ
      LoLoUse { S7_SetPoint := 'True'} : Bool;   // Признак использования НАУ
      Value : Real;   // Значение переменной
      MaskValue { S7_SetPoint := 'True'} : Real;   // Значение маскирования сигнала
      MinEU { S7_SetPoint := 'True'} : Real;   // Мин. значение шкалы
      MaxEU { S7_SetPoint := 'True'} : Real;   // Макс. значение шкалы
      HiHi { S7_SetPoint := 'True'} : Real;   // Значение ВАУ
      Hi { S7_SetPoint := 'True'} : Real;   // Значение ВПУ
      Lo { S7_SetPoint := 'True'} : Real;   // Значение НПУ
      LoLo { S7_SetPoint := 'True'} : Real;   // Значение НАУ
      Current : Real;   // Значение тока, mA
      Factor { S7_SetPoint := 'True'} : Real := 1.0;   // Коэф. масштабирования
      Tf { S7_SetPoint := 'True'} : Real;   // Постоянная фильтра, с
      ValuePrev : Real;   // Значение переменной на предыдущем такте
      Threshold { S7_SetPoint := 'True'} : Real := 0.5;   // Величина гистирезиса (в процентах от шкалы сигнала)
      Timeout { S7_SetPoint := 'True'} : DInt := DINT#3000;   // Задержка срабатывания аларма, мсек
      TimeLoLo : DInt := DINT#0;   // Текущее время таймера НАУ
      TimeLo : DInt := DINT#0;   // Текущее время таймера НПУ
      TimeHi : DInt := DINT#0;   // Текущее время таймера ВПУ
      TimeHiHi : DInt := DINT#0;   // Текущее время таймера ВАУ
      AIType { S7_SetPoint := 'True'} : Int := 0;   // Тип сигнала (0:4-20мА, 1:КИП, 2:Температура, 5:ABB WORD)
      RES_6 : Int;   // Резерв
      AdrByte { S7_SetPoint := 'True'} : Int := -1;   // Адрес (байт)
      Overflow : Int := 32766;   // Переполнение
      Underflow : Int := -32766;   // Переполнение снизу
      MinRaw { S7_SetPoint := 'True'} : Int := 0;   // Мин. значение сигнала АЦП
      MaxRaw { S7_SetPoint := 'True'} : Int := 27648;   // Макс. значение сигнала АЦП
      RawVal : Int;   // Первоначальное значение АЦП (не масштабированное)
      StatusBYTE { S7_SetPoint := 'True'} : Int := -1;   // Адрес байта статуса (для цифровых сигналов КИП)
      StatusBIT { S7_SetPoint := 'True'} : Int := -1;   // Номер бита качества в статус-байте (для КИП)
   END_STRUCT;

END_TYPE

DATA_BLOCK "SystemInfo"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
   STRUCT 
      Pulse : Bool;
      FirstScan : Bool;
      Cycle : Int;
      MaxCycle : Int;
      MinCycle : Int;
      SysTime : DInt;
      ModelInit : Bool;
      PLCInit : Bool;
      PLCInitTime : DInt;
      NulINT : Int;
      NulREAL : Real;
      NulDINT : DInt;
      NulBOOL : Bool;
      sAI : Bool;
      sAO : Bool;
      sDI : Bool;
      sDO : Bool;
      sAM : Bool;
      sDM : Bool;
      Model_Enable : Bool;
      Motor_Enable : Bool;
      Valve_Enable { ExternalVisible := 'False'} : Bool;
      ValveReg_Enable : Bool;
      Conv_Enable : Bool;
      PS_Enable : Bool;
      PID_Enable : Bool;
      ARS_Enable : Bool;
      LOCK_Enable : Bool;
      LOCK_Init : Bool;
      EPS_Enable : Bool;
      Alarm_Enable : Bool;
      Auto_Enable : Bool;
      Cnt_Enable : Bool;
      CALIBR_Enable : Bool;
      Weigher_Enable : Bool;
      DIAGDP_Enable : Bool;
      CALC_Enable : Bool;
      Mill_Enable : Bool;
      ApFeeder_Enable : Bool;
      Grinder_Enable : Bool;
      Thickener_Enable : Bool;
      Panel_Enable : Bool;
      DEXCH_Enable : Bool;
   END_STRUCT;


BEGIN
   FirstScan := TRUE;
   PLCInitTime := DINT#1000;
   NulINT := 0;
   NulREAL := 0.0;
   NulDINT := DINT#0;
   NulBOOL := FALSE;
   sAI := TRUE;
   sAO := TRUE;
   sDI := TRUE;
   sDO := TRUE;
   sAM := TRUE;
   sDM := TRUE;
   Model_Enable := FALSE;
   Motor_Enable := TRUE;
   Valve_Enable := TRUE;
   ValveReg_Enable := TRUE;
   Conv_Enable := FALSE;
   PS_Enable := TRUE;
   PID_Enable := TRUE;
   ARS_Enable := TRUE;
   LOCK_Enable := TRUE;
   LOCK_Init := FALSE;
   EPS_Enable := TRUE;
   Alarm_Enable := TRUE;
   Auto_Enable := TRUE;
   Cnt_Enable := TRUE;
   CALIBR_Enable := FALSE;
   Weigher_Enable := FALSE;
   DIAGDP_Enable := TRUE;
   CALC_Enable := TRUE;
   Mill_Enable := FALSE;
   ApFeeder_Enable := FALSE;
   Grinder_Enable := FALSE;
   Thickener_Enable := FALSE;
   Panel_Enable := FALSE;
   DEXCH_Enable := FALSE;

END_DATA_BLOCK

DATA_BLOCK "DI"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
   STRUCT 
      Count : Int;
      Item : Array[1..99] of "TDIData";
   END_STRUCT;


