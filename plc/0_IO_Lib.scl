   Item[4].Tf := 1.0;
   Item[4].AdrByte := 1052;
   Item[4].MaxRaw := 16384;   // в выгрузке было Underflow := 16384 (опечатка: при этом всё ниже 100 % — недостоверно)
   Item[4].StatusBYTE := -1;
