   Count := 2;
   // Item[1]  %QW1002  Н-1: задание скорости ПЧ (Slave_1, PPO6 PCD2 = MRV, 16384 = 100 %)
   Item[1].MaxEU := 100.0;
   Item[1].AdrByte := 1002;
   Item[1].MaxRaw := 16384;
   // Item[2]  %QW1052  Н-2: задание скорости ПЧ (Slave_2, PPO6 PCD2 = MRV, 16384 = 100 %)
   Item[2].MaxEU := 100.0;
   Item[2].AdrByte := 1052;
