   Item[7].StatusBYTE := -1;
   Item[7].StatusBIT := -1;
   // Item[8]  %IW8  Датчик давления гидроподпора 36.5 (Н-2) — защита HH/LL в автомате
   Item[8].AlmDisable := TRUE;
