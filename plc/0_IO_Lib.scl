DATA_BLOCK "GCU_Sys"
TITLE = 'Служебные данные: измерение времени цикла'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   STRUCT 
      LastRT : LReal;   // память для RUNTIME
   END_STRUCT;


BEGIN

END_DATA_BLOCK

FUNCTION "SYS_Cycle" : Void
TITLE = 'Время цикла в SystemInfo.Cycle (мс) для обработчиков DI/AI'
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      CycleMs : Real;
   END_VAR


BEGIN
	// На S7-1500 нет OB1_PREV_CYCLE, поэтому время цикла меряем через RUNTIME
	#CycleMs := LREAL_TO_REAL(RUNTIME("GCU_Sys".LastRT)) * 1000.0;
	#CycleMs := LIMIT(MN := 1.0, IN := #CycleMs, MX := 1000.0);
	"SystemInfo".Cycle := REAL_TO_INT(#CycleMs);
	"SystemInfo".FirstScan := FALSE;
	
END_FUNCTION

FUNCTION "DIAlm_HNDL" : Void
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : Ким
FAMILY : ГОК
VERSION : 0.1
   VAR_IN_OUT 
      Signal : "TDIData";
   END_VAR

   VAR_TEMP 
      Sample_T : Int;
   END_VAR


BEGIN
	
	#Sample_T := 0;
	
	// Инициализация данных
	#Sample_T := "SystemInfo".Cycle;
	
	// Алармы отключены или нет качества сигнала
	IF #Signal.AlmDisable OR NOT #Signal.Quality THEN
	  #Signal.IsAlarm := false;
	  
	  // Алармы включены
	ELSE
	  
	  IF #Signal.AlmUse THEN
	    // При появлении тревожного сигнала запускается таймер    
	    IF #Signal.Value = #Signal.AlmMode THEN
	      IF #Signal.TimeAlarm < #Signal.Timeout THEN
	        #Signal.TimeAlarm := #Signal.TimeAlarm + #Sample_T;
	      ELSE
	        #Signal.IsAlarm := true;        // Выставление аварии по истечению таймера
	      END_IF;
	      // Сброс аварии и таймера
	    ELSE
	      #Signal.IsAlarm := false;
	      #Signal.TimeAlarm := 0;
	    END_IF;
	  ELSE
	    #Signal.IsAlarm := false;
	    #Signal.TimeAlarm := 0;
	  END_IF;
	  
	END_IF;
	
END_FUNCTION

FUNCTION "AIAlm_HNDL" : Void
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : Ким
FAMILY : ГОК
VERSION : 0.1
   VAR_IN_OUT 
      Signal : "TAIData";
   END_VAR

   VAR_TEMP 
      Threshold : Real;
      Sample_T : Int;
   END_VAR


BEGIN
	  // Инициализация данных
	  #Sample_T := "SystemInfo".Cycle;
	  #Threshold := 0.0;
	  
	  // Алармы отключены или нет качества сигнала
	  IF #Signal.AlmDisable OR NOT #Signal.Quality THEN
	    #Signal.AlmLoLo := false;
	    #Signal.AlmLo := false;
	    #Signal.AlmHiHi := false;
	    #Signal.AlmHi := false;
	    
	    // Алармы включены
	  ELSE
	    
	    // Вычисление величины гистерезиса
	    #Threshold := #Signal.Threshold * (#Signal.MaxEU - #Signal.MinEU) / 100;
	    
	    // Гистерезис используется для того чтобы избежать постоянных изменений аларма при колебаниях сигнала возле границы.
	    
	    // --- Нижняя аварийная граница ---
	    IF #Signal.LoLoUse THEN
	      // Определение момента пересечения границы (возврат реализован с гистерезисом)
	      IF #Signal.Value <= #Signal.LoLo THEN
	        // Запуск таймера при пересечении границы
	        IF #Signal.TimeLoLo < #Signal.Timeout THEN
	          #Signal.TimeLoLo := #Signal.TimeLoLo + #Sample_T;
	        ELSE
	          #Signal.AlmLoLo := true;        // Выставление аварии по истечению таймера
	        END_IF;
	        
	        // Сброс аварии и таймера    
	      ELSIF #Signal.Value >= #Signal.LoLo + #Threshold THEN
	        #Signal.AlmLoLo := false;
	        #Signal.TimeLoLo := 0;
	      END_IF;
	      
	    ELSE
	      #Signal.AlmLoLo := false;
	      #Signal.TimeLoLo := 0;
	    END_IF;
	    
	    // --- Нижняя предупредительная граница ---
	    IF #Signal.LoUse THEN
	      // Определение момента пересечения границы (возврат реализован с гистерезисом)
	      IF #Signal.Value <= #Signal.Lo THEN
	        // Запуск таймера при пересечении границы
	        IF #Signal.TimeLo < #Signal.Timeout THEN
	          #Signal.TimeLo := #Signal.TimeLo + #Sample_T;
	        ELSE
	          #Signal.AlmLo := true;        // Выставление аварии по истечению таймера
	        END_IF;
	        
	        // Сброс аварии и таймера    
	      ELSIF #Signal.Value >= #Signal.Lo + #Threshold THEN
	        #Signal.AlmLo := false;
	        #Signal.TimeLo := 0;
	      END_IF;
	      
	    ELSE
	      #Signal.AlmLo := false;
	      #Signal.TimeLo := 0;
	    END_IF;
	    
	    // --- Верхняя предупредительная граница ---
	    IF #Signal.HiUse THEN
	      // Определение момента пересечения границы (возврат реализован с гистерезисом)
	      IF #Signal.Value >= #Signal.Hi THEN
	        // Запуск таймера при пересечении границы
	        IF #Signal.TimeHi < #Signal.Timeout THEN
	          #Signal.TimeHi := #Signal.TimeHi + #Sample_T;
	        ELSE
	          #Signal.AlmHi := true;        // Выставление аварии по истечению таймера
	        END_IF;
	        
	        // Сброс аварии и таймера    
	      ELSIF #Signal.Value <= #Signal.Hi - #Threshold THEN
	        #Signal.AlmHi := false;
	        #Signal.TimeHi := 0;
	      END_IF;
	      
	    ELSE
	      #Signal.AlmHi := false;
	      #Signal.TimeHi := 0;
	    END_IF;
	    
	    
	    // --- Верхняя аварийная граница ---
	    IF #Signal.HiHiUse THEN
	      // Определение момента пересечения границы (возврат реализован с гистерезисом)
	      IF #Signal.Value >= #Signal.HiHi THEN
	        // Запуск таймера при пересечении границы
	        IF #Signal.TimeHiHi < #Signal.Timeout THEN
	          #Signal.TimeHiHi := #Signal.TimeHiHi + #Sample_T;
	        ELSE
	          #Signal.AlmHiHi := true;        // Выставление аварии по истечению таймера
	        END_IF;
	        
	        // Сброс аварии и таймера
	      ELSIF #Signal.Value <= #Signal.HiHi - #Threshold THEN
	        #Signal.AlmHiHi := false;
	        #Signal.TimeHiHi := 0;
	      END_IF;
	      
	    ELSE
	      #Signal.AlmHiHi := false;
	      #Signal.TimeHiHi := 0;
	    END_IF;
	    
	  END_IF; // конец алармы включены
	  
	  
END_FUNCTION

FUNCTION "DO_HNDL" : Void
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : Шишеня
FAMILY : ГОК
VERSION : 0.1
   VAR_INPUT 
      ID : Int;
   END_VAR

   VAR_TEMP 
      Quality : Bool;
      RawVal : Bool;
      Value : Bool;
      AdrByte : Int;
      AdrBit : Int;
      DOVar : "TDOData";
   END_VAR


BEGIN
	// Сброс L-стека
	#Quality := false;
	#RawVal := false;
	#Value := false;
	#AdrByte := 0;
	#AdrBit := 0;
	
	
	// Запись в локальную копию экземпляра переменной DO
	#DOVar := "DO".Item[#ID];
	
	// Обработка переменной если она активна    
	IF #DOVar.Active THEN
	  
	  // Физический адрес сигнала
	  #AdrByte := #DOVar.AdrByte;
	  #AdrBit := #DOVar.AdrBit;
	  
	  // РУЧНОЕ ЗНАЧЕНИЕ ПЕРЕМЕННОЙ            
	  // Если сигнал замаскирован, взять замаскированое значение
	  // и выставить признак достоверности        
	  IF #DOVar.Mask THEN
	    #DOVar.Value := #DOVar.MaskValue;
	    #Quality := TRUE;                            // У замаскированного сигнала качество всегда TRUE
	    // АВТОМАТИЧЕСКОЕ ЗНАЧЕНИЕ ПЕРЕМЕННОЙ
	    // Сигнал не замаскирован
	  ELSE
	    
	    // Качество сигнала по статус-байту
	    IF #DOVar.StatusBYTE >= 0                                    // если указан адрес статусного байта
	      AND #DOVar.StatusBIT >= 0 AND #DOVar.StatusBIT <= 7 THEN       // и указан номер бита качества в сатусном байте
	      #Quality := PEEK_BOOL(area := 16#81, dbNumber := 0, byteOffset := #DOVar.StatusBYTE, bitOffset := #DOVar.StatusBIT);       // считывание сигнала качества из соответствующего бита         
	      // статусный байт не указан
	    ELSE
	      #Quality := TRUE;
	    END_IF;
	    //Вычисление признака качества по корректности адреса  
	    #Quality := #Quality AND (#AdrByte >= 0) AND (#AdrBit >= 0) AND (#AdrBit <= 7);
	    
	  END_IF;
	  // КОНЕЦ ручной/автоматической обработки переменной
	  
	  
	  // Обработка RawVal при хорошем качестве
	  IF #Quality THEN
	    #DOVar.RawVal := #DOVar.Value XOR #DOVar.Inverse;
	  ELSE
	    #DOVar.RawVal := FALSE;
	  END_IF;
	  
	  // Запись в физ. выходной канал значения переменной
	  IF (#AdrByte >= 0) AND (#AdrBit >= 0) AND (#AdrBit <= 7)
	  THEN
	    POKE_BOOL(area := 16#82, dbNumber := 0, byteOffset := #AdrByte, bitOffset := #AdrBit, value := #DOVar.RawVal);
	  END_IF;
	  
	  // Если переменная неактивна, то качество FALSE    
	ELSE
	  #Quality := false;
	  
	END_IF; // КОНЕЦ определения активности переменной            
	
	#DOVar.Quality := #Quality;
	#DOVar.Quality_inv := NOT #DOVar.Quality;
	
	// Запись из локальной копии в DB
	
	"DO".Item[#ID] := #DOVar;
	
END_FUNCTION

FUNCTION "DI_HNDL" : Void
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : Шишеня
FAMILY : ГОК
VERSION : 0.1
   VAR_INPUT 
      ID : Int;
   END_VAR

   VAR_TEMP 
      Value : Bool;
      Quality : Bool;
      AdrByte : Int;
      AdrBit : Int;
      Sample_T : Real;
      DIVar : "TDIData";
   END_VAR


BEGIN
	// Сбрсо L-стека
	#Value := false;
	#Quality := false;
	#AdrByte := 0;
	#AdrBit := 0;
	#Sample_T := 0.0;
	
	
	// Запись в локальную копию экземпляра переменной DI
	#DIVar := "DI".Item[#ID];
	
	// Обработка переменной если она активна    
	IF #DIVar.Active THEN
	  
	  // Физический адрес сигнала
	  #AdrByte := #DIVar.AdrByte;
	  #AdrBit := #DIVar.AdrBit;
	  // Чтение из физ. входного канала 
	  IF (#AdrByte >= 0) AND (#AdrBit >= 0) AND (#AdrBit <= 7)
	  THEN
	    #DIVar.RawVal := PEEK_BOOL(area := 16#81, dbNumber := 0, byteOffset := #AdrByte, bitOffset := #AdrBit);
	  ELSE
	    #DIVar.RawVal := FALSE;
	  END_IF;
	  
	  
	  // РУЧНОЕ ЗНАЧЕНИЕ ПЕРЕМЕННОЙ            
	  // Если сигнал замаскирован, взять замаскированое значение
	  // и выставить признак достоверности        
	  IF #DIVar.Mask THEN
	    #DIVar.Value := #DIVar.MaskValue;                     // Запись в переменную значения маски 
	    #Quality := TRUE;                                // У замаскированного сигнала качество всегда TRUE
	    
	    // АВТОМАТИЧЕСКОЕ ЗНАЧЕНИЕ ПЕРЕМЕННОЙ
	    // Сигнал не замаскирован
	  ELSE
	    
	    // Качество сигнала по статус-байту
	    IF #DIVar.StatusBYTE >= 0                                    // если указан адрес статусного байта
	        AND #DIVar.StatusBIT >= 0 AND #DIVar.StatusBIT <= 7 THEN       // и указан номер бита качества в сатусном байте
	      #Quality := PEEK_BOOL(area := 16#81, dbNumber := 0, byteOffset := #DIVar.StatusBYTE, bitOffset := #DIVar.StatusBIT);       // считывание сигнала качества из соответствующего бита         
	      // статусный байт не указан
	    ELSE
	      #Quality := true;
	    END_IF;
	    //Вычисление признака качества по корректности адреса  
	    #Quality := #Quality AND (#AdrByte >= 0) AND (#AdrBit >= 0) AND (#AdrBit <= 7);
	    
	    // Значение сигнала принимается при хорошем качестве
	    #Value := false;
	    IF #Quality THEN
	      #Value := #DIVar.RawVal XOR #DIVar.Inverse;
	      ;
	    END_IF;
	    
	    // Фильтрация значения
	    IF #DIVar.Tf > 0.1 THEN
	      #Sample_T := INT_TO_REAL("SystemInfo".Cycle) / 1000.0;
	      IF #Value <> #DIVar.ValuePrev THEN
	        #DIVar.Acc := #DIVar.Acc + #Sample_T;
	        IF #DIVar.Acc >= #DIVar.Tf THEN
	          #DIVar.ValuePrev := #Value;
	          #DIVar.Acc := 0.0;
	        END_IF;
	      ELSE
	        #DIVar.Acc := 0.0;
	      END_IF;
	    ELSE
	      #DIVar.ValuePrev := #Value;
	      #DIVar.Acc := 0.0;
	    END_IF;
	    #DIVar.Value := #DIVar.ValuePrev;
	    
	  END_IF;
	  // КОНЕЦ ручной/автоматической обработки переменной
	  
	  // Если переменная неактивна, то качество FALSE    
	ELSE
	  #Quality := FALSE;
	  
	END_IF; // КОНЕЦ определения активности переменной            
	
	//Запись бита качества 
	#DIVar.Quality := #Quality;
	#DIVar.Quality_inv :=NOT #DIVar.Quality;
	// Алармы
	"DIAlm_HNDL"(Signal := #DIVar);
	
	// Запись из локальной копии в DB
	
	"DI".Item[#ID] := #DIVar;
	
END_FUNCTION

FUNCTION "AO_HNDL" : Void
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : Шишеня
FAMILY : ГОК
VERSION : 0.1
   VAR_INPUT 
      ID : Int;
   END_VAR

   VAR_TEMP 
      RawRange : Real;
      UnitRange : Real;
      Quality : Bool;
      RawVal : Int;
      Value : Real;
      AOVar : "TAOData";
   END_VAR


BEGIN
	// сброс L-стека
	#RawRange := 0.0;
	#UnitRange := 0.0;
	#Quality := false;
	#RawVal := 0;
	#Value := 0.0;
	
	// Запись в локальную копию экземпляра переменной AO
	#AOVar := "AO".Item[#ID];
	
	IF #AOVar.Active THEN
	  
	  // Для переменной обязательно должен быть указан адрес начального байта
	  #Quality := (#AOVar.AdrByte > -1);
	  
	  CASE #AOVar.AOType OF
	          
	          //*******ТИП 0. Сигналы 4-20 мА. 
	          // REAL -> WORD[AdrByte].  Масшабирование по шкале.
	      0:
	          // Если сигнал замаскирован, взять замаскированое значение
	          IF #AOVar.Mask THEN
	              #AOVar.Value := #AOVar.MaskValue;
	          END_IF;
	          
	          // Заданное значение 
	          #Value := #AOVar.Value;
	          // Ограничение по шкале
	          #Value := LIMIT(MN := #AOVar.MinEU, IN := #Value, MX := #AOVar.MaxEU);
	          
	          // Масштабирование
	          IF #Quality THEN
	              #RawRange := INT_TO_REAL(#AOVar.MaxRaw - #AOVar.MinRaw);
	              #UnitRange := #AOVar.MaxEU - #AOVar.MinEU;
	              
	              #RawVal := REAL_TO_INT(#RawRange * (#Value - #AOVar.MinEU) / #UnitRange);
	              #RawVal := #RawVal + #AOVar.MinRaw;
	              // значение тока
	              // #AOVar.Current := 4.0 + #AOVar.RawVal * 6.10370e-4;
	              #AOVar.Current := #AOVar.RawVal * 16.0 / #AOVar.MaxRaw + 4.0;
	          ELSE
	              #RawVal := 0;
	          END_IF;
	          
	          //*******ТИП 1. Команды устройствам КИП. 
	          // WORD -> WORD[AdrByte].  Масшабирования нет.
	      1:
	          // Масштабирование и маскирование для данного типа сигнала не используется
	          #AOVar.Mask := false;
	          #AOVar.MaskValue := 0.0;
	          #AOVar.MinEU := 0.0;
	          #AOVar.MaxEU := 0.0;
	          #Value := 0.0;        // заданное значение REAL не используется
	          #AOVar.Current := 0.0; // расчет тока не используется
	          
	          // В функциях обработки устройств КИП в поле RawVal записывается код команды (в формате INT)
	          // далее команда отсылается по адресу AdrByte (см. ниже)
	          #RawVal := #AOVar.RawVal;
	          
	      2:
	          // Если сигнал замаскирован, взять замаскированое значение
	          IF #AOVar.Mask THEN
	              #AOVar.Value := #AOVar.MaskValue;
	          END_IF;
	          
	          // Заданное значение 
	          #Value := #AOVar.Value;
	          #AOVar.Current := 0.0; // расчет тока не используется
	          
	          //*******ТИП 5. Сигналы ABB WORD. 
	          // REAL -> WORD[AdrByte].  Масшабирование по шкале.
	      5:
	          // Если сигнал замаскирован, взять замаскированое значение
	          IF #AOVar.Mask THEN
	              #AOVar.Value := #AOVar.MaskValue;
	          END_IF;
	          
	          #AOVar.MinRaw := 0;      // Мин. значение сигнала АЦП
	          #AOVar.MaxRaw := 16384;   // Макс. значение сигнала АЦП 
	          
	          // Заданное значение 
	          #Value := #AOVar.Value;
	          // Ограничение по шкале
	          #Value := LIMIT(MN := #AOVar.MinEU, IN := #Value, MX := #AOVar.MaxEU);
	          
	          // Масштабирование
	          IF #Quality THEN
	              #RawRange := INT_TO_REAL(#AOVar.MaxRaw - #AOVar.MinRaw);
	              #UnitRange := #AOVar.MaxEU - #AOVar.MinEU;
	              
	              #RawVal := REAL_TO_INT(#RawRange * (#Value - #AOVar.MinEU) / #UnitRange);
	              #RawVal := #RawVal + #AOVar.MinRaw;
	              // значение тока
	              
	          ELSE
	              #RawVal := 0;
	          END_IF;
	          
	  END_CASE;
	  
	  // запись кода в образ выходов по указанному адресу
	  IF #AOVar.AdrByte > -1 THEN
	    POKE(area := 16#82, dbNumber := 0, byteOffset := #AOVar.AdrByte, value := INT_TO_WORD(#RawVal));
	  END_IF;
	  
	  // синал не активен                    
	ELSE
	  #AOVar.Quality := false;
	END_IF;
	
	#AOVar.Value := #Value;
	#AOVar.Quality := #Quality;
	#AOVar.RawVal := #RawVal;
	#AOVar.Quality_inv := NOT #AOVar.Quality;
	// Запись из локальной копии в DB
	#AOVar.Quality_inv := NOT #Quality;
	"AO".Item[#ID] := #AOVar;
	
END_FUNCTION

FUNCTION "AI_HNDL" : Void
TITLE = 'Переменные. Функция обработки AI'
{ S7_Optimized_Access := 'FALSE' }
AUTHOR : Шишеня
FAMILY : ГОК
VERSION : 0.0
   VAR_INPUT 
      ID : Int;   // Индекс переменной AI в VDB
   END_VAR

   VAR_TEMP 
      RawRange : Real;
      UnitRange : Real;
      Quality : Bool;
      Value : Real;
      Cycle : Real;
      R : Real;
      AIVar : "TAIData";
   END_VAR


BEGIN
	
	// сброс L-стека
	#RawRange := 0.0;
	#UnitRange := 0.0;
	#Quality := false;
	#Value := 0.0;
	#Cycle := 0.0;
	#R := 0.0;
	
	
	// Запись в локальную копию экземпляра переменной AI
	#AIVar := "AI".Item[#ID];
	
	IF #AIVar.Active THEN
	  
	  // Для переменной обязательно должен быть указан адрес начального байта
	  #Quality := (#AIVar.AdrByte > -1);
	  
	  IF #AIVar.AdrByte > -1 THEN
	    CASE #AIVar.AIType OF
	        //*******ТИП 0. Сигналы 4-20 мА. 
	        // WORD[AdrByte] -> REAL. Масшабирование по шкале. Качество по диапазону.
	      0:
	        // Считывание значения сигнала 
	        #AIVar.RawVal := WORD_TO_INT(PEEK_WORD(area := 16#81, dbNumber := 0, byteOffset := #AIVar.AdrByte));
	        // Определение качества по выходу сигнала за допустимый диапазон
	        #Quality := #Quality AND (#AIVar.RawVal <= #AIVar.Overflow);
	        #Quality := #Quality AND (#AIVar.RawVal >= #AIVar.Underflow);
	        // качество сигнала по статус-байту
	        IF #AIVar.StatusBYTE >= 0                                    // если указан адрес статусного байта
	            AND #AIVar.StatusBIT >= 0 AND #AIVar.StatusBIT <= 7 THEN       // и указан номер бита качества в сатусном байте
	            #Quality := #Quality AND  PEEK_BOOL(area := 16#81, dbNumber := 0, byteOffset := #AIVar.StatusBYTE, bitOffset := #AIVar.StatusBIT);       // считывание сигнала качества из соответствующего бита   
	        END_IF;
	        
	        // Если сигнал достоверен, производим масштабирование        
	        IF #Quality THEN
	          #RawRange := INT_TO_REAL(#AIVar.MaxRaw - #AIVar.MinRaw);
	          #UnitRange := #AIVar.MaxEU - #AIVar.MinEU;
	          
	          #Value := #UnitRange * INT_TO_REAL(#AIVar.RawVal - #AIVar.MinRaw) / #RawRange;
	          #Value := (#Value + #AIVar.MinEU) * #AIVar.Factor;
	          // Вычисление значения тока, mA
	          //#AIVar.Current:= #AIVar.RawVal*6.10370e-4 + 4.0;
	          #AIVar.Current := #AIVar.RawVal * 16.0 / #AIVar.MaxRaw + 4.0;
	        END_IF;
	        
	        
	        //*******ТИП 1. Цифровые сигналы с ЧРП DANFOS. 
	        // WORD[AdrByte] -> INT. Масшабирование REAL по коэффициенту. Качество по статус-байту (или по диапазону, если адрес статус-байта не указан).
	    1:
	        // Считывание значения сигнала 
	        // Если сигнал достоверен, производим масштабирование
	        #Value := DINT_TO_REAL(WORD_TO_DINT(PEEK_WORD(area := 16#81, dbNumber := 0, byteOffset := #AIVar.AdrByte))) * #AIVar.Factor;
	        #AIVar.RawVal := 0;   // код АЦП не используется
	        #AIVar.Current := 0.0; // расчет тока не используется
	        
	        // качество сигнала по статус-байту
	        IF #AIVar.StatusBYTE >= 0                                    // если указан адрес статусного байта
	          AND #AIVar.StatusBIT >= 0 AND #AIVar.StatusBIT <= 7 THEN       // и указан номер бита качества в сатусном байте
	          #Quality := PEEK_BOOL(area := 16#81, dbNumber := 0, byteOffset := #AIVar.StatusBYTE, bitOffset := #AIVar.StatusBIT);       // считывание сигнала качества из соответствующего бита         
	          
	          // // статусный байт не указан
	          // ELSE 
	          //     // Определение качества по выходу сигнала за заданный диапазон (+10%)
	          //     #Quality:= #Quality AND (#Value <= 1.1*#AIVar.MaxEU);      
	          //     #Quality:= #Quality AND (#Value >= 1.1*#AIVar.MinEU);                                          
	      END_IF;
	      
	      
	        //*******ТИП 2. Сигналы с масштабированием по коэффициенту. 
	        // WORD[AdrByte] -> REAL. Масшабирование INT по коэффициенту. Качество по диапазону. 
	      2:
	        // Считывание кода сигнала 
	        #AIVar.RawVal := WORD_TO_INT(PEEK_WORD(area := 16#81, dbNumber := 0, byteOffset := #AIVar.AdrByte));
	        #AIVar.Current := 0.0; // расчет тока не используется
	        // Определение качества по выходу сигнала за заданный для масштабирования диапазон
	        #Quality := #Quality AND (#AIVar.RawVal <= #AIVar.MaxRaw);
	        #Quality := #Quality AND (#AIVar.RawVal >= #AIVar.MinRaw);
	        
	        // Если сигнал достоверен, производим масштабирование        
	        IF #Quality THEN
	          #Value := #AIVar.RawVal * #AIVar.Factor;
	        END_IF;
	        
	        //*******ТИП 3. Цифровые сигналы с приборов КИП с масштабированием по коэффициенту. 
	        // DWORD[AdrByte] -> DINT * KOEF -> REAL. Масшабирование DINT по коэффициенту. Качество по диапазону. 
	      3:
	        // Считывание значения сигнала 
	        #Value := DINT_TO_REAL(DWORD_TO_DINT(PEEK_DWORD(area := 16#81, dbNumber := 0, byteOffset := #AIVar.AdrByte))) * #AIVar.Factor;
	        #AIVar.RawVal := 0;   // код АЦП не используется
	        #AIVar.Current := 0.0; // расчет тока не используется
	        
	        // качество сигнала по статус-байту
	        IF #AIVar.StatusBYTE >= 0                                    // если указан адрес статусного байта
	          AND #AIVar.StatusBIT >= 0 AND #AIVar.StatusBIT <= 7 THEN       // и указан номер бита качества в сатусном байте
	          #Quality := PEEK_BOOL(area := 16#81, dbNumber := 0, byteOffset := #AIVar.StatusBYTE, bitOffset := #AIVar.StatusBIT);       // считывание сигнала качества из соответствующего бита         
	          
	          // статусный байт не указан
	        ELSE
	          // Определение качества по выходу сигнала за заданный диапазон (+10%)
	          #Quality := #Quality AND (#Value <= 1.1 * #AIVar.MaxEU);
	          #Quality := #Quality AND (#Value >= 1.1 * #AIVar.MinEU);
	        END_IF;
	        
	    END_CASE;
	    
	    // Фильтрация сигнала (для всех типов)
	    IF #AIVar.Tf >= 0.1 THEN
	      #Cycle := INT_TO_REAL("SystemInfo".Cycle) / 1000.0;
	      #R := #Cycle / #AIVar.Tf;
	      #Value := #AIVar.ValuePrev * (1.0 - #R) + #Value * #R;
	      IF ABS(#Value) < 0.001 THEN
	        #Value := 0.0;
	      END_IF;
	    END_IF;
	    #AIVar.ValuePrev := #Value;
	    
	  END_IF; // конец AIVar.AdrByte > -1
	  
	  // Сигнал замаскирован -- записать значение и выставить признак достоверности
	  IF #AIVar.Mask THEN
	    #Value := #AIVar.MaskValue;
	    #Quality := true;
	END_IF;
	
	  // Ограничение по шкале
	  #Value := LIMIT(MN := #AIVar.MinEU, IN := #Value, MX := #AIVar.MaxEU);
	  
	  // Запись значений в локальную копию                          
	  #AIVar.Value := #Value;
	  #AIVar.Quality := #Quality;
	  
	  // синал не активен            
	ELSE
	  #AIVar.Quality := false;
	  #AIVar.Value := 0.0;
	END_IF; // конец AIVar.Active
	
	#AIVar.Quality_inv := NOT #AIVar.Quality;
	// Алармы
	"AIAlm_HNDL"(Signal := #AIVar);
	
	// Запись из локальной копии в DB
	"AI".Item[#ID] := #AIVar;
	
	
	
END_FUNCTION

