// DB AI — блок пользователя (выгрузка из TIA 2026-10-24); добавлены только комментарии и исправление Item[4]
DATA_BLOCK "AI"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
   STRUCT 
      Count : Int;
      Item : Array[1..18] of "TAIData";
   END_STRUCT;


BEGIN
   Count := 18;
   // Item[1]  %IW47  Уровень зумпфа, %
   Item[1].HiHiUse := TRUE;
   Item[1].HiUse := TRUE;
   Item[1].LoUse := TRUE;
   Item[1].LoLoUse := TRUE;
   Item[1].MaxEU := 100.0;
   Item[1].HiHi := 95.0;
   Item[1].Hi := 85.0;
   Item[1].Lo := 20.0;
   Item[1].LoLo := 10.0;
   Item[1].Tf := 2.0;
   Item[1].AdrByte := 47;
   Item[1].StatusBYTE := -1;
   Item[1].StatusBIT := -1;
   // Item[2]  %IW81  Давление на входе гидроциклонов, бар
